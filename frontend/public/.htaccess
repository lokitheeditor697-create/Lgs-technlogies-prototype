<IfModule mod_rewrite.c>
  RewriteEngine On

  # Disable directory listing
  Options -Indexes

  # If the request is for a directory but doesn't have a trailing slash, and the .html exists, serve the .html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # If the request HAS a trailing slash (like /verify/), remove it and serve the .html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} ^/(.*)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^(.*)/$ /$1.html [L]
</IfModule>
